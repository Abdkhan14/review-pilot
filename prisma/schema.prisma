generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support enums; app code enforces "BASIC" | "SAAS"
// SQLite does not support Json; details is stored as a JSON string

model Business {
  id                 String           @id @default(cuid())
  slug               String           @unique
  tier               String           // "BASIC" | "SAAS"
  name               String
  placeId            String
  customInstructions String?
  writeReviewUrl     String?          // googleMapsLinks.writeAReviewUri from Places API (New)
  details            String?          // JSON string of normalized Place Details
  detailsFetchedAt   DateTime?
  createdAt          DateTime         @default(now())
  handoff            BusinessHandoff?
}

model BusinessHandoff {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  count      Int
  day        String   // UTC "YYYY-MM-DD"
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// SQLite does not support enums; app code enforces the allowed actions.
// Details is stored as a JSON string, same as Business.details.

model DemoPlace {
  placeId          String        @id
  name             String
  writeReviewUrl   String?       // googleMapsLinks.writeAReviewUri from Places API (New)
  details          String?       // JSON string of normalized PlaceSnapshot
  detailsFetchedAt DateTime?
  generationsUsed  Int           @default(0)
  generationLimit  Int?          // null = demo.generationsPerPlace
  blocked          Boolean       @default(false)
  createdAt        DateTime      @default(now())
  sessions         DemoSession[]
}

model DemoSession {
  id                 String    @id
  placeId            String
  place              DemoPlace @relation(fields: [placeId], references: [placeId], onDelete: Cascade)
  customInstructions String?
  ipHash             String
  generations        Int       @default(0)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// Sign-in tables. Better Auth reads and writes these through its Prisma adapter.
// role / banned / banReason / banExpires and impersonatedBy belong to its admin plugin.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
