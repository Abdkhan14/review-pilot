DATABASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
APP_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Comma-separated fallback chain tried in order on 404 model_not_found errors.
# Every model here must accept the same params as OPENAI_MODEL (temperature,
# frequency/presence penalties, reasoning_effort "none"). gpt-6-luna does not.
OPENAI_FALLBACK_MODELS=gpt-5.4-mini
# Set to "off" to skip the humanize editor pass entirely (kill switch / A/B)
DRAFT_EDIT_PASS=
DRAFT_EDIT_DEBUG=
GOOGLE_MAPS_API_KEY=
SNAPSHOT_MAX_AGE_DAYS=
# Feature flags — set to "1" or "true" to enable; admins always see them as on.
FF_NEW_LANDING=
FF_SELF_SERVE=
# Better Auth: signs session cookies, and the app's public URL for sign-in redirects.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Google OAuth client. Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of admin email addresses (used for ADMIN_EMAILS gate).
ADMIN_EMAILS=
# Comma-separated list of tester/viewer email addresses.
TESTER_EMAILS=
