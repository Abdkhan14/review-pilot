TURSO_AUTH_TOKEN=
ADMIN_PASSWORD=
AUTH_SECRET=
APP_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Comma-separated fallback chain tried in order on 404 model_not_found errors.
# Every model here must accept the same params as OPENAI_MODEL (temperature,
# frequency/presence penalties, reasoning_effort "none"). gpt-6-luna does not.
OPENAI_FALLBACK_MODELS=gpt-5.4-mini
# Set to "off" to skip the humanize editor pass entirely (kill switch / A/B)
DRAFT_EDIT_PASS=
DRAFT_EDIT_DEBUG=
GOOGLE_MAPS_API_KEY=
SNAPSHOT_MAX_AGE_DAYS=
