    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "axios": "^1.20.0",
    "better-auth": "^1.7.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compromise": "^14.17.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.73.0",
    "next": "16.3.5",
    "openai": "^7.20.0",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
