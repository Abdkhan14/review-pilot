    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^29.1.1",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
