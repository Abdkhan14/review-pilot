{
  "name": "review-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "migrate": "if [ -n \"$TURSO_DATABASE_URL\" ]; then npx tsx scripts/migrate-turso.ts; else prisma migrate deploy; fi",
    "build": "npm run migrate && prisma generate && next build",
